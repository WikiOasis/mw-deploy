APP_NAME="WikiOasis Console"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://console.wikioasis.org

# The name the chrome and the sign-in page show. Defaults to APP_NAME.
# CONSOLE_NAME="WikiOasis Console"

# App ids to switch off for this install, comma separated. A disabled app
# disappears from the launcher and its API answers 404. Currently: deployments.
# CONSOLE_DISABLED_APPS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mwdeploy
DB_USERNAME=mwdeploy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverb keeps the live deployment dashboard fed without polling. Set to "log"
# in development if you do not want to run the websocket server.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# A deploy job blocks for as long as an rsync or l10n rebuild takes, so give it
# a dedicated queue and a worker with --timeout=0. --timeout=0 only stops the
# *worker process* from killing the job — the queue driver separately assumes a
# job died if it isn't deleted within retry_after seconds (default 90) and
# redelivers it, which RunDeployment's tries=1 then fails outright with "has been
# attempted too many times or run too long". Set retry_after well past the
# longest a deployment could plausibly take (matching RunDeployment's own
# 6-hour uniqueFor() lock).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=21600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="deploy@wikioasis.org"
MAIL_FROM_NAME="${APP_NAME}"

# Generate the key and secret with `openssl rand -hex 24` (any opaque string).
# They are shared secrets between the app, the Reverb server and the browser —
# the key is public, the secret is not.
REVERB_APP_ID=mwdeploy
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where the Reverb process listens. Keep it on the loopback and let nginx proxy
# to it; Reverb has no TLS and no auth of its own.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# The *public* URL the browser opens a websocket to, i.e. what the edge proxy
# terminates. Behind HAProxy + nginx this is the portal's own hostname on 443.
REVERB_HOST=deploy.wikioasis.org
REVERB_PORT=443
REVERB_SCHEME=https

# Where this app reaches Reverb, which is not where the browser does. Leave these
# on the loopback: routing the server-side leg out through the edge proxy just to
# reach a local service is a pointless round trip that breaks if the edge cannot
# route back to itself.
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http

# Compiled into the JS bundle at `npm run build` time, not read at runtime — a
# change here needs a rebuild, not just a config:clear.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

###############################################################################
# Deploy portal — Salt transport
#
# The portal runs on the Salt master and never speaks SSH. Every fleet
# operation is `salt '<minion>' cmd.run_all '<mwdeploy-shim ...>'`.
###############################################################################

MWDEPLOY_SALT_BINARY=/usr/bin/salt
MWDEPLOY_SALT_MODULE=cmd.run_all
MWDEPLOY_SALT_TIMEOUT=300
MWDEPLOY_PROCESS_SLACK=60
MWDEPLOY_SALT_EXTRA_ARGS=

# The runner CLI, used only to poll a job started with `salt --async` (the
# import screen's tree-scan runs this way rather than blocking the request).
MWDEPLOY_SALT_RUN_BINARY=/usr/bin/salt-run
MWDEPLOY_SALT_ASYNC_START_TIMEOUT=30
MWDEPLOY_SALT_ASYNC_POLL_TIMEOUT=30

# Absolute path of mwdeploy-shim as installed on the minions.
MWDEPLOY_SHIM_BINARY=/usr/local/bin/mwdeploy-shim

# HOME for the `salt` subprocess. The salt CLI creates `~/.salt` while it parses
# its own arguments, so run as a user whose home is not writable — www-data's
# /var/www, typically — it exits 64 with a PermissionError traceback before it has
# contacted a single minion. The default is a directory inside the app's own
# storage, which the web user necessarily owns.
#
# Leave this commented out unless the host already gives the web user a writable
# home: setting it to an empty value means "inherit HOME", which is the behaviour
# it exists to avoid.
# MWDEPLOY_SALT_HOME=/var/lib/mwdeploy

# MediaWiki tree layout.
MWDEPLOY_STAGING_PATH=/srv/mediawiki-staging
MWDEPLOY_PROD_PATH=/srv/mediawiki
MWDEPLOY_PATCH_PATH=/srv/mediawiki/scripts/extensions/patches

# Where the config repository (mw-config) is checked out, relative to the deploy
# root. It sits outside versions/ because one config serves every core version.
# Farms disagree on the name: config, mw-config and wikiconfig are all in the wild.
MWDEPLOY_CONFIG_DIR=config

# Salt minion id of the staging host, where all preparation steps run.
MWDEPLOY_STAGING_TARGET=staging

# Rollout defaults.
MWDEPLOY_DEFAULT_PARALLEL=1
MWDEPLOY_MAX_PARALLEL=8
MWDEPLOY_HAPROXY_BACKEND=mediawiki
MWDEPLOY_CANARY_VHOST=meta.wikioasis.org
MWDEPLOY_CANARY_RETRIES=3
# The canary connects straight to the appserver's own listener, which on most
# fleets is the plain-HTTP backend behind HAProxy/nginx TLS termination. Set
# to https (and MWDEPLOY_CANARY_PORT=443) only if appservers terminate TLS
# themselves.
MWDEPLOY_CANARY_SCHEME=http
# MWDEPLOY_CANARY_PORT=80
MWDEPLOY_L10N_WIKI=testwiki

# Blocking canary prompts. An unanswered prompt falls back to
# MWDEPLOY_DECISION_TIMEOUT_DEFAULT so the farm is never left mid-rollout on a
# broken ref: one of continue | abort | abort_and_rollback.
MWDEPLOY_DECISION_POLL=2
MWDEPLOY_DECISION_TIMEOUT=900
MWDEPLOY_DECISION_TIMEOUT_DEFAULT=abort_and_rollback

# Adopting a farm that already exists. `mwdeploy-shim tree-scan` reads the tree —
# every versions/<ver>, the extensions and skins in it, their remotes and current
# refs, and each extension.json — and the import screen turns that into registry
# rows. Read-only throughout: nothing in this path writes to the tree.
#
# Scan staging (the tree deployments are built in, so its refs are the ones worth
# pinning) or production, for a farm that has no staging host yet.
MWDEPLOY_SCAN_ROOT=staging
MWDEPLOY_SCAN_LIMIT=5000
MWDEPLOY_SCAN_MANIFESTS=true
MWDEPLOY_CONFIG_REPO_NAME=mw-config

# Import a directory that is on disk but is not a git checkout? Leave this off. Such
# a directory has no remote to pin, so the portal could never update or restore it,
# and a registry row claiming otherwise is worse than no row.
MWDEPLOY_IMPORT_NON_GIT=false

# Branch/commit discovery for the ref picker: salt | local | none
# "salt" asks the staging minion and is always correct; "local" only works when
# the Salt master and the staging tree are the same host.
MWDEPLOY_GIT_DRIVER=salt
MWDEPLOY_GIT_COMMIT_LIMIT=30
MWDEPLOY_GIT_BINARY=/usr/bin/git
MWDEPLOY_GIT_TIMEOUT=60
